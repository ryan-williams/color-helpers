#!/usr/bin/env bash

local cur_dir="$(dirname "${BASH_SOURCE[0]}")"

export GIT_PROMPT=1

__prompt_command() {
  local EXIT="$?"
  PS1=""

  local cur_dir="$(dirname "${BASH_SOURCE[0]}")"

  # Setup prompt colors
  try_source "$cur_dir/prompt_colors"

  history -a

  # Show repo//subdir when in a subdirectory, worktree, or submodule
  local prompt_dir toplevel
  if toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    local cwd="$(pwd)"
    local repo="$(basename "$toplevel")"
    if [ "$cwd" != "$toplevel" ]; then
      local rel="${cwd#$toplevel/}"
      if [[ "$rel" == */* ]]; then
        # 2+ levels deep: PROMPT_DIR_SHORT=1 for repo//basename, default to full relpath
        if [ -n "$PROMPT_DIR_SHORT" ]; then
          prompt_dir="${repo}//$(basename "$rel")"
        else
          prompt_dir="${repo}/${rel}"
        fi
      else
        prompt_dir="${repo}/${rel}"
      fi
    elif [ -f "$toplevel/.git" ]; then
      # Worktree or submodule: .git is a file, not a directory
      local common_dir project_root
      common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
      # Project root is parent of the git dir. common_dir may be:
      #   /path/to/project/.git                (normal repo)
      #   /path/to/project/.git/modules/name   (submodule)
      #   /path/to/project/.bare               (bare repo, or any non-.git name)
      # Strip from /.git component if present, otherwise just dirname.
      project_root="${common_dir%/.git*}"
      if [ "$project_root" = "$common_dir" ]; then
        project_root="$(dirname "$common_dir")"
      fi
      prompt_dir="$(basename "$project_root")/${repo}"
    else
      prompt_dir="$repo"
    fi
  else
    prompt_dir="$(basename "$(pwd)")"
  fi

  echo -ne "\033]1;${prompt_dir}\007"

  # Red background if previous command failed, yellow otherwise.
  if [ $EXIT != 0 ]; then
    PS1+="${On_IRed}"
  else
    PS1+="${On_IYellow}"
  fi

  PS1+="${BIBlack}"
  PS1+=" "
  PS1+="\D{%a %H:%M:%S}"
  PS1+=" "
  PS1+="$clear"
  PS1+=" "
  PS1+="${BBlue}\u${clear}"
  PS1+="@"
  PS1+="${BGreen}\h${clear}"
  PS1+=": "
  PS1+="${BPurple}${prompt_dir}${clear}"
  if [ -z "$GIT_PROMPT" ]; then
    PS1+="${BRed}${clear}"
  else
    PS1+="${BRed}\$(__git_ps1 :%s)${clear}"
  fi
  PS1+="\$ "
}

# Append to PROMPT_COMMAND instead of overwriting it (preserves direnv hook)
# Only add if not already present to avoid duplicates
# Check for exact match with word boundaries (semicolon or start/end of string)
if [[ ! "$PROMPT_COMMAND" =~ (^|;)__prompt_command(;|$) ]]; then
  export PROMPT_COMMAND="${PROMPT_COMMAND}${PROMPT_COMMAND:+;}__prompt_command"
fi

try_source "$cur_dir/bash_colors"
try_source "/etc/bash_completion"

if [ -s "$HOME"/.dircolors ] && which dircolors &>/dev/null; then
  debug "sourcing .dircolors"
  eval "$(dircolors ~/.dircolors)"
fi
